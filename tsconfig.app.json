{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/route-map.d.ts",
    "src/auto-imports.d.ts",
    "src/components.d.ts",
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/pages/Installer/*",
    "src/pages/VDR/SetupEditor2.vue",
  ],
  "compilerOptions": {
    "module": "ESNext", // Diese Zeile hinzufügen
    "moduleResolution": "Bundler",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      // other types...
      "vite-plugin-vue-layouts-next/client",
      "vite/client",
      "vuetify",
      "vue-router/auto",
    ],
    "lib": [
      "ESNext",
      "DOM", // Manuelle Absicherung
    ]
  },
  "vueCompilerOptions": {
    "plugins": [
      "vue-router/volar/sfc-typed-router",
      "vue-router/volar/sfc-route-blocks",
    ],
  },
}